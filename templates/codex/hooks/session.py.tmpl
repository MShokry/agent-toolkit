"""Capture only the team launcher's main Codex session, from hook JSON."""
import json
import os
from pathlib import Path
import re
import sys


FIELD = re.compile(r"\*\*(Status|Blocked since|Latest handoff):\*\*\s*(.*)")
MAX_TASKS = 8
MAX_FIELD = 160


def task_number(path):
    match = re.fullmatch(r"T-(\d+)\.md", path.name)
    return int(match.group(1)) if match else -1


def active_tasks(directory):
    """One line per task that is not done, read from the state-file header."""
    lines = []
    for path in sorted(directory.glob("T-*.md"), key=task_number):
        if task_number(path) < 0 or path.is_symlink() or not path.is_file():
            continue
        fields = {}
        try:
            header = path.read_text(errors="replace").splitlines()[:60]
        except OSError:
            continue
        for line in header:
            match = FIELD.match(line)
            if match and match.group(1) not in fields:
                fields[match.group(1)] = match.group(2).strip()[:MAX_FIELD]
        status = fields.get("Status", "")
        if not status or status.split()[0] == "done":
            continue
        line = f"- {path.stem} [{status}] handoff: {fields.get('Latest handoff') or 'none'}"
        blocked = fields.get("Blocked since", "")
        if blocked and not blocked.startswith(("—", "-")):
            line += f" | blocked since: {blocked}"
        lines.append(line)
    return lines[-MAX_TASKS:]


def main():
    team = os.environ.get("TEAM_CODEX_SESSION", "")
    if not team:
        return  # Ordinary Codex conversations have no toolkit-owned pin.
    if not re.fullmatch(r"[a-zA-Z0-9_-]+", team):
        raise ValueError("invalid team name")
    event = json.load(sys.stdin)
    if not isinstance(event, dict):
        raise ValueError("hook input must be an object")
    if event.get("hook_event_name") not in ("SessionStart", "UserPromptSubmit"):
        return
    root = Path(__file__).resolve().parent.parent
    cwd = Path(event["cwd"]).resolve()
    if cwd != root and root not in cwd.parents:
        raise ValueError("hook cwd is outside this repository")
    session = event["session_id"]
    if not isinstance(session, str) or not re.fullmatch(r"[a-zA-Z0-9_-]+", session):
        raise ValueError("invalid Codex session id")
    directory = root / ".pipeline"
    if directory.is_symlink():
        raise ValueError("runtime directory must stay inside the repository")
    directory.mkdir(exist_ok=True)
    pin = directory / f".codex-session-id.{team}"
    if pin.is_symlink():
        raise ValueError("session pin must not be a symlink")
    # Exclusive creation avoids concurrent hooks replacing another thread's id.
    try:
        with pin.open("x") as output:
            output.write(session + "\n")
    except FileExistsError:
        if pin.read_text().strip() != session:
            raise ValueError("session differs from the pinned lead; use a different team name")
    if event["hook_event_name"] != "SessionStart":
        return  # Capture only; per-prompt output would grow the lead's context.
    print("Team lead session captured. Use $feature for feature work; runtime records live in .pipeline/.")
    tasks = active_tasks(directory)
    if tasks:
        # A resumed or compacted lead starts from disk, not memory. This is a
        # pointer list; the state files and worker status are the authority.
        print("Unfinished pipeline tasks (verify each state file and worker status before dispatching):")
        print("\n".join(tasks))


if __name__ == "__main__":
    try:
        main()
    except (KeyError, TypeError, ValueError, OSError) as error:
        print(f"codex-session: {error}", file=sys.stderr)
        sys.exit(2)
