#!/usr/bin/env bash
#
# Mechanically copies "Findings for docs" lines from a task state file into
# the project docs they name. This is how a review finding that's true
# beyond one task (a platform gotcha, a design gap, an incident) ends up
# documented without either (a) the lead retyping it by hand, or (b)
# granting a review/implementer agent direct write access to project docs.
#
# No LLM call. No agent ever writes to docs/ directly through this path —
# a role only *proposes* a line (in its own state-file scope), and this
# script does the literal, non-interpretive copy. That keeps project
# documentation out of the blast radius of an agent permission mistake.
#
# Findings are written as:
#   - [docs/SOME-DOC.md] one-line finding text
# under a "## Findings for docs" heading in .agent-pipeline/tasks/T-<id>.md.
#
# Destinations are limited to Markdown files under docs/ (or the roots in
# PROMOTE_DOC_ROOTS, colon-separated, set by the project owner). Anything
# else — project guidance, role contracts, scripts, hidden directories,
# symlinked paths — is skipped with a message for the human to place by hand.
#
# Usage: .agent-pipeline/bin/promote-findings.sh T-03

set -eu

# Anchor to the repo root like oc.sh/team.sh do, so the script works from any
# CWD and — more importantly — so the repo-escape check below is checked
# against a known root rather than wherever the caller happened to be.
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

ID="${1:?usage: promote-findings.sh <task-id, e.g. T-03>}"
FILE=".agent-pipeline/tasks/${ID}.md"
[ -f "$FILE" ] || { echo "promote-findings.sh: no such file: $FILE" >&2; exit 1; }

LINES="$(awk '/^## Findings for docs/{f=1;next} /^## /{f=0} f && /^- \[/' "$FILE")"

if [ -z "$LINES" ]; then
  echo "promote-findings.sh: no findings tagged for promotion in $FILE"
  exit 0
fi

DATE="$(date +%Y-%m-%d)"

printf '%s\n' "$LINES" | while IFS= read -r line; do
  DOC="$(printf '%s\n' "$line" | sed -n 's/^- \[\([^]]*\)\].*/\1/p')"
  TEXT="$(printf '%s\n' "$line" | sed 's/^- \[[^]]*\] *//')"
  # The doc path comes from state-file content an agent wrote. Treat it as
  # untrusted: refuse absolute paths and any ".." segment, so a finding can
  # never write outside this repo — the whole point of routing docs writes
  # through this script instead of granting agents write access to docs/.
  case "$DOC" in
    ''|/*)
      echo "promote-findings.sh: skip unsafe/invalid doc path (must be repo-relative): $line" >&2
      continue ;;
  esac
  case "/$DOC/" in
    */../*)
      echo "promote-findings.sh: skip doc path escaping the repo root: $line" >&2
      continue ;;
  esac
  # Refusing ".." is not enough: the path is still agent-authored, and an
  # append to project guidance, a role contract, or a script is an instruction
  # or code change made by a role that is supposed to be read-only (a line
  # appended to a shell script runs on its next use). Findings land only in
  # Markdown files under an approved documentation root — docs/ by default;
  # the project owner may widen it with a colon-separated PROMOTE_DOC_ROOTS.
  # Pipeline state and hidden tool directories are never a destination.
  ALLOWED=0
  OLD_IFS="$IFS"; IFS=:
  for root in ${PROMOTE_DOC_ROOTS:-docs}; do
    root="${root%/}"
    case "$root" in ''|/*|.*|*/.*|*..*) continue ;; esac
    case "$DOC" in "$root"/*) ALLOWED=1 ;; esac
  done
  IFS="$OLD_IFS"
  case "$DOC" in
    *.md) : ;;
    *) ALLOWED=0 ;;
  esac
  case "/$DOC" in */.*) ALLOWED=0 ;; esac
  if [ "$ALLOWED" -eq 0 ]; then
    echo "promote-findings.sh: skip doc path outside the approved documentation roots (${PROMOTE_DOC_ROOTS:-docs}; Markdown only): $line" >&2
    continue
  fi
  # No existing component may be a symlink, or the append leaves the root.
  LINKED=0; probe="$DOC"
  while [ "$probe" != "." ] && [ "$probe" != "/" ]; do
    if [ -L "$probe" ]; then LINKED=1; break; fi
    probe="$(dirname "$probe")"
  done
  if [ "$LINKED" -eq 1 ]; then
    echo "promote-findings.sh: skip doc path through a symlink: $line" >&2
    continue
  fi
  mkdir -p "$(dirname "$DOC")"
  [ -f "$DOC" ] || printf '# %s\n' "$(basename "$DOC" .md)" > "$DOC"
  if grep -qF "$TEXT" "$DOC" 2>/dev/null; then
    echo "promote-findings.sh: already present, skipped: $DOC <- $TEXT"
    continue
  fi
  {
    printf '\n## From %s — %s\n\n' "$ID" "$DATE"
    printf -- '- %s\n' "$TEXT"
  } >> "$DOC"
  echo "promote-findings.sh: appended to $DOC: $TEXT"
done
