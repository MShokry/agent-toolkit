#!/usr/bin/env bash
#
# BEGIN USAGE
# tmux layout for the agent team.
#
#   pane 0 (left, big)    claude          <- you talk to the lead here
#   pane 1 (top right)    opencode serve  <- the server oc.sh attaches to
#   pane 2 (mid right)    .agents/ activity tail
#   pane 3 (bottom right) free pane
#
# Usage:
#   scripts/team.sh [session-name]        start (or attach to) the team
#   scripts/team.sh --fresh                start a NEW lead conversation
#                                          instead of resuming (see below)
#   scripts/team.sh --port <N>             opencode server port (default 4096)
#   scripts/team.sh --kill [session-name]
#
# Resuming is the default, not an opt-in: pane 0 resumes the lead's own
# Claude conversation, pinned to this session name via a stored UUID (see
# .agents/.claude-session-id.<session-name>) rather than `claude --continue`
# (which just means "the most recent conversation in this directory" — with
# no notion of *which* tmux session started it, so a second team.sh session
# name in the same repo, or even a one-off `claude` run there, could steal
# the next --continue). That matters because killing this tmux session (the
# usual way to free up a port so a second project can use scripts/team.sh at
# the same time) used to also throw away the lead's context — there was no
# way back into the same conversation short of scrolling terminal history.
# The pinned session id fixes that: kill the session, come back later, run
# scripts/team.sh again, the lead picks up its own thread — never someone
# else's. Pass --fresh on the rare run where you actually want a clean
# slate (this also mints a new pinned id, so future resumes follow it).
#
# Running two projects at once: opencode's server binds one port per
# process, so two projects both defaulting to --port 4096 collide — the
# second scripts/team.sh's `opencode serve` fails to bind. Give the second
# project its own port: `scripts/team.sh --port 4097`. That port is written
# to .agents/.oc-port in this repo, and scripts/oc.sh reads it automatically
# (when OC_SERVER isn't set) — so oc.sh calls in this project just work
# without you having to export OC_SERVER by hand every time. bin/init.sh
# adds .agents/.oc-port to this project's .gitignore; it's local machine
# state, not something to commit.
#
# See docs/TEAM.md for more.
# END USAGE

set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${OC_PORT:-4096}"
SESSION="__PROJECT_NAME__"
FRESH=0
KILL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --kill)   KILL=1; shift ;;
    --fresh)  FRESH=1; shift ;;
    --port)   [ $# -ge 2 ] || { echo "team.sh: --port needs a value" >&2; exit 1; }
              PORT="$2"; shift 2 ;;
    -h|--help)
      awk '/^# BEGIN USAGE$/ {f=1; next} /^# END USAGE$/ {f=0} f' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)        SESSION="$1"; shift ;;
  esac
done

if [ "$KILL" -eq 1 ]; then
  tmux kill-session -t "$SESSION" 2>/dev/null && echo "killed $SESSION" || echo "no such session"
  exit 0
fi

command -v tmux >/dev/null 2>&1 || { echo "team.sh: tmux not found" >&2; exit 1; }

gen_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import uuid; print(uuid.uuid4())'
  else
    echo "team.sh: need uuidgen or python3 to mint a Claude session id" >&2
    exit 1
  fi
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "team.sh: session '$SESSION' already exists — attaching"
  exec tmux attach -t "$SESSION"
fi

mkdir -p "$REPO_ROOT/.agents"
printf '%s' "$PORT" > "$REPO_ROOT/.agents/.oc-port"

# Pin pane 0 to one Claude conversation per tmux session name (see usage
# comment above for why --continue alone isn't enough).
SESSION_ID_FILE="$REPO_ROOT/.agents/.claude-session-id.$SESSION"
[ "$FRESH" -eq 1 ] && rm -f "$SESSION_ID_FILE"

if [ -f "$SESSION_ID_FILE" ]; then
  CLAUDE_UUID="$(cat "$SESSION_ID_FILE")"
  # Fall back to re-minting under the same id if the stored conversation is
  # gone (history pruned, project path changed) so the pane never just dies.
  CLAUDE_CMD="claude --resume $CLAUDE_UUID || claude --session-id $CLAUDE_UUID"
else
  CLAUDE_UUID="$(gen_uuid)"
  printf '%s' "$CLAUDE_UUID" > "$SESSION_ID_FILE"
  CLAUDE_CMD="claude --session-id $CLAUDE_UUID"
fi

tmux new-session -d -s "$SESSION" -c "$REPO_ROOT" -n team

tmux split-window -h -t "$SESSION:team" -c "$REPO_ROOT"
tmux send-keys -t "$SESSION:team.1" "opencode serve --port $PORT" C-m

tmux split-window -v -t "$SESSION:team.1" -c "$REPO_ROOT"
tmux send-keys -t "$SESSION:team.2" \
  "echo '--- .agents/ activity ---'; ls -t .agents/ 2>/dev/null; \
   command -v fswatch >/dev/null 2>&1 \
     && fswatch -o .agents | while read -r _; do date '+%H:%M:%S'; ls -t .agents/ | head -5; done \
     || while true; do sleep 5; ls -t .agents/ 2>/dev/null | head -5; done" C-m

tmux split-window -v -t "$SESSION:team.2" -c "$REPO_ROOT"

tmux select-pane -t "$SESSION:team.0"
tmux send-keys -t "$SESSION:team.0" "$CLAUDE_CMD" C-m

exec tmux attach -t "$SESSION"
