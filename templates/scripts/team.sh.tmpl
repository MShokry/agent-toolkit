#!/usr/bin/env bash
#
# BEGIN USAGE
# tmux layout for the agent team.
#
#   pane 0 (left, big)    claude/codex/opencode <- you talk to the lead here
#   pane 1 (top right)    opencode serve  <- the server oc.sh attaches to
#   pane 2 (mid right)    .pipeline/ activity tail
#   pane 3 (bottom right) free pane
#
# Usage:
#   scripts/team.sh [session-name]        start (or attach to) the team
#   scripts/team.sh --fresh                start a NEW lead conversation
#                                          instead of resuming (see below)
#   scripts/team.sh --port <N>             opencode server port (default 4096)
#   scripts/team.sh --lead <auto|claude|codex|opencode>
#                                          lead selection (default auto:
#                                          Claude, then Codex, then OpenCode)
#   scripts/team.sh --kill [session-name]
#
# For Claude and Codex, resuming is the default, not an opt-in. Claude resumes the
# lead's conversation pinned to this session name via a stored UUID (see
# .pipeline/.claude-session-id.<session-name>) rather than `claude --continue`
# (which just means "the most recent conversation in this directory" — with
# no notion of *which* tmux session started it, so a second team.sh session
# name in the same repo, or even a one-off `claude` run there, could steal
# the next --continue). That matters because killing this tmux session (the
# usual way to free up a port so a second project can use scripts/team.sh at
# the same time) used to also throw away the lead's context — there was no
# way back into the same conversation short of scrolling terminal history.
# The pinned session id fixes that: kill the session, come back later, run
# scripts/team.sh again, the lead picks up its own thread — never someone
# else's. Pass --fresh on the rare run where you actually want a clean
# slate (this also mints a new pinned id, so future resumes follow it). Codex
# captures its actual id with reviewed lifecycle hooks and resumes that exact
# id through codex-lead.sh. Missing/failed pins require explicit recovery.
# OpenCode starts a new lead chat by default: --continue could select the
# latest worker session instead. Set TEAM_OPENCODE_SESSION to a known lead
# session id to resume it; --fresh ignores that variable. Run /feature in
# pane 0 to select the leader agent (the TUI has no --agent flag).
#
# Running two projects at once: opencode's server binds one port per
# process, so two projects both defaulting to --port 4096 collide — the
# second scripts/team.sh's `opencode serve` fails to bind. Give the second
# project its own port: `scripts/team.sh --port 4097`. That port is written
# to .pipeline/.oc-port in this repo, and scripts/oc.sh reads it automatically
# (when OC_SERVER isn't set) — so oc.sh calls in this project just work
# without you having to export OC_SERVER by hand every time. bin/init.sh
# adds .pipeline/.oc-port to this project's .gitignore; it's local machine
# state, not something to commit.
#
# opencode v2's `serve` always auth-gates the API (v1 had none): unless
# OPENCODE_PASSWORD/OPENCODE_SERVER_PASSWORD is set, it mints a random one
# and only prints it once to the pane. This script generates one instead and
# writes it to .pipeline/.oc-password (same gitignore treatment as
# .oc-port) so scripts/oc.sh can read it on every call without you copying
# it out of pane 1 by hand. The server is launched with a command that reads
# the file at runtime (`$(cat .pipeline/.oc-password)`) rather than the literal
# secret, so the password itself never appears in the pane's typed-command
# echo or tmux scrollback.
#
# Note this password sits in the project's own working tree, readable by any
# agent's shell tool — an agent that read it could call the API directly
# (list/abort *other* sessions, not just its own), beyond what it's supposed
# to touch. Low severity today (these agents already have source + git
# access), but don't treat the password as secret from the agents themselves,
# only from the outside.
#
# See docs/TEAM.md for more.
# END USAGE

set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${OC_PORT:-4096}"
SESSION="__PROJECT_NAME__"
LEAD="${TEAM_LEAD:-auto}"
FRESH=0
KILL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --kill)   KILL=1; shift ;;
    --fresh)  FRESH=1; shift ;;
    --lead)   [ $# -ge 2 ] || { echo "team.sh: --lead needs a value" >&2; exit 1; }
              LEAD="$2"; shift 2 ;;
    --port)   [ $# -ge 2 ] || { echo "team.sh: --port needs a value" >&2; exit 1; }
              PORT="$2"; shift 2 ;;
    -h|--help)
      awk '/^# BEGIN USAGE$/ {f=1; next} /^# END USAGE$/ {f=0} f' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)        SESSION="$1"; shift ;;
  esac
done

if [ "$KILL" -eq 1 ]; then
  tmux kill-session -t "$SESSION" 2>/dev/null && echo "killed $SESSION" || echo "no such session"
  exit 0
fi

command -v tmux >/dev/null 2>&1 || { echo "team.sh: tmux not found" >&2; exit 1; }

if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "team.sh: session '$SESSION' already exists — attaching"
  exec tmux attach -t "$SESSION"
fi

case "$LEAD" in
  auto)
    if command -v claude >/dev/null 2>&1; then
      LEAD="claude"
    elif command -v codex >/dev/null 2>&1; then
      LEAD="codex"
    elif command -v opencode >/dev/null 2>&1; then
      LEAD="opencode"
    else
      echo "team.sh: no supported lead CLI (claude, codex, opencode) is installed" >&2
      exit 1
    fi ;;
  claude|codex|opencode)
    command -v "$LEAD" >/dev/null 2>&1 || { echo "team.sh: $LEAD is not installed" >&2; exit 1; } ;;
  *)
    echo "team.sh: --lead must be auto, claude, codex, or opencode" >&2
    exit 1 ;;
esac

# Validate before writes or panes: never interpolate arbitrary shell text into
# the lead command. Session ids are obtained from OpenCode, not invented here.
if [ "$LEAD" = "opencode" ] && [ "$FRESH" -eq 0 ] && [ -n "${TEAM_OPENCODE_SESSION:-}" ]; then
  case "$TEAM_OPENCODE_SESSION" in
    ses_?*)
      case "$TEAM_OPENCODE_SESSION" in
        *[!A-Za-z0-9_]*) echo "team.sh: invalid TEAM_OPENCODE_SESSION" >&2; exit 1 ;;
      esac ;;
    *) echo "team.sh: TEAM_OPENCODE_SESSION must be a real ses_ id" >&2; exit 1 ;;
  esac
fi

gen_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import uuid; print(uuid.uuid4())'
  else
    echo "team.sh: need uuidgen or python3 to mint a Claude session id" >&2
    exit 1
  fi
}

gen_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  elif [ -r /dev/urandom ]; then
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import secrets; print(secrets.token_hex(32))'
  else
    echo "team.sh: need openssl, /dev/urandom, or python3 to mint a server password" >&2
    exit 1
  fi
}

mkdir -p "$REPO_ROOT/.pipeline"
printf '%s' "$PORT" > "$REPO_ROOT/.pipeline/.oc-port"
PASSWORD_FILE="$REPO_ROOT/.pipeline/.oc-password"
# umask before the write, not chmod after, so the file is never briefly
# world/group-readable between creation and permission-fixing.
( umask 077; gen_password > "$PASSWORD_FILE" )

if [ "$LEAD" = "claude" ]; then
  # Pin pane 0 to one Claude conversation per tmux session name (see usage
  # comment above for why --continue alone isn't enough).
  SESSION_ID_FILE="$REPO_ROOT/.pipeline/.claude-session-id.$SESSION"
  [ "$FRESH" -eq 1 ] && rm -f "$SESSION_ID_FILE"

  if [ -f "$SESSION_ID_FILE" ]; then
    CLAUDE_UUID="$(cat "$SESSION_ID_FILE")"
    # Fall back to re-minting under the same id if the stored conversation is
    # gone (history pruned, project path changed) so the pane never just dies.
    LEAD_CMD="claude --resume $CLAUDE_UUID || claude --session-id $CLAUDE_UUID"
  else
    CLAUDE_UUID="$(gen_uuid)"
    printf '%s' "$CLAUDE_UUID" > "$SESSION_ID_FILE"
    LEAD_CMD="claude --session-id $CLAUDE_UUID"
  fi
elif [ "$LEAD" = "codex" ]; then
  [[ "$SESSION" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "team.sh: invalid Codex team name" >&2; exit 1; }
  LEAD_CMD="bash scripts/codex-lead.sh $SESSION"
  [ "$FRESH" -eq 0 ] || LEAD_CMD="$LEAD_CMD --fresh"
else
  LEAD_CMD="OPENCODE_PASSWORD=\"\$(cat '$PASSWORD_FILE')\" opencode --server http://localhost:$PORT"
  if [ "$FRESH" -eq 0 ] && [ -n "${TEAM_OPENCODE_SESSION:-}" ]; then
    LEAD_CMD="$LEAD_CMD --session $TEAM_OPENCODE_SESSION"
  fi
  echo "team.sh: OpenCode lead — run /feature or /toolkit-update in pane 0"
fi

tmux new-session -d -s "$SESSION" -c "$REPO_ROOT" -n team

tmux split-window -h -t "$SESSION:team" -c "$REPO_ROOT"
tmux send-keys -t "$SESSION:team.1" \
  "OPENCODE_PASSWORD=\"\$(cat '$PASSWORD_FILE')\" opencode serve --port $PORT" C-m

tmux split-window -v -t "$SESSION:team.1" -c "$REPO_ROOT"
tmux send-keys -t "$SESSION:team.2" \
  "echo '--- .pipeline/ activity ---'; ls -t .pipeline/ 2>/dev/null; \
   command -v fswatch >/dev/null 2>&1 \
     && fswatch -o .pipeline | while read -r _; do date '+%H:%M:%S'; ls -t .pipeline/ | head -5; done \
     || while true; do sleep 5; ls -t .pipeline/ 2>/dev/null | head -5; done" C-m

tmux split-window -v -t "$SESSION:team.2" -c "$REPO_ROOT"

tmux select-pane -t "$SESSION:team.0"
tmux send-keys -t "$SESSION:team.0" "$LEAD_CMD" C-m

exec tmux attach -t "$SESSION"
