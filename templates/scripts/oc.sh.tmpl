#!/usr/bin/env bash
#
# BEGIN USAGE
# Wrapper for every OpenCode invocation in the agent pipeline.
#
# Updated 2026-09-27 for opencode v2 (installed: v2.0.18). v2 is a breaking
# upgrade from the v1.18.x this script was originally written against:
# `opencode run --attach` is gone (replaced by `--server`, see below), the
# API moved under /api/* with {"data": ...}-wrapped, cursor-paginated
# responses, `opencode serve` now always auth-gates the API (v1 had none —
# see the password section below), and the abort endpoint moved from
# POST /session/<id>/abort to POST /api/session/<id>/interrupt. Anything
# below not explicitly marked "verified against v2" is carried over from the
# v1 design and may need re-checking again on the next major bump.
#
# Why this exists rather than calling `opencode run` directly:
#
#   1. --server reuses an already-running `opencode serve`, skipping MCP cold
#      boot on every call. Without it each invocation pays startup again.
#   2. `opencode run` can hang in a non-TTY if the agent hits an unanswerable
#      permission prompt. Every call is bounded — see the watchdog note below.
#   3. Model is an argument, so the lead can switch vendors without editing a
#      single agent prompt.
#
# Usage:
#   scripts/oc.sh --agent reviewer --model hcnsec/DeepSeek-V4-Pro \
#                 --prompt-file .pipeline/T-001.review-request.md
#   scripts/oc.sh --agent tester --model hcnsec/auto --prompt "run the suite"
#   echo "..." | scripts/oc.sh --agent reviewer --model hcnsec/glm-5.3
#
# --session <id> continues an existing OpenCode session instead of starting a
# new one — pass the session id captured from an earlier call's "session=..."
# line (also visible in --raw-out as each event's sessionID). The pipeline's
# session scope is one task *per role*, not one call: a role's first call for a
# task omits --session and starts one, and only that same role's retry passes
# the id back. Builder, reviewer and tester never share a session — on v2 a
# session pins the opening agent's tool set (see .claude/commands/feature.md).
# Every call (with or without --session) prints the session id it used to
# stderr on completion so the caller can record it.
#
# --text extracts just the agent's final prose from the JSON event stream. The
# raw stream is still what crosses the wire (and is kept with --raw-out), but it
# inlines the full contents of every file the agent reads, so it is unreadable
# for a human and expensive to paste back into a state file.
#
# --status is the read-only companion to a dispatch: it launches no agent,
# takes no prompt, and needs neither --agent nor --model. It reports whether
# the OpenCode sessions you name are currently active, which is the question
# a detached dispatch leaves behind when its own wrapper is killed before it
# can print the `oc.sh: session=` line:
#
#   scripts/oc.sh --status ses_abc ses_def   # one "active" / "not active" line each
#   scripts/oc.sh --status                   # the raw active-session map
#
# Why not GET /session/status, the name the v1 workflow used: it does not
# exist on v2. Live against v2.0.23 it answers the web UI's
# HTML, and /api/session/status is a 400 because v2 reads `status` as a
# session id. v2's endpoint is GET /api/session/active — see type
# V2SessionActiveData in the installed SDK at
# .opencode/node_modules/@opencode-ai/sdk/dist/v2/gen/types.gen.d.ts — whose
# 200 body is {"data": {<sessionID>: {type: "running"}}}, i.e. exactly
# {"data":{}} when nothing is running, which is still a success.
#
# Server, credential and API resolution are the ones every dispatch already
# uses, so this call cannot drift from them and the password never reaches a
# command line. Raw curl is not an alternative: v2 always auth-gates the API.
#
# Exit 0 on success — including "no session is active"; 1 on a usage,
# transport or malformed-response error.
#
# --interrupt is --status's write companion: it stops the named sessions'
# running turns server-side and launches nothing:
#
#   scripts/oc.sh --interrupt ses_abc         # one "interrupted" / "not running" line each
#
# Use it when the lead deliberately stops a dispatch (a mid-task model switch,
# a user's "stop"), never to "unstick" a session --status still reports active
# on its own — an active session is working, and the rule is to wait for it.
# Killing only the local wrapper does not stop the turn: the agent keeps
# editing the tree with nobody listening (T-035). Interrupt first, then kill
# the wrapper, then confirm with --status. v2's endpoint is
# POST /api/session/<id>/interrupt (v1 called it /session/<id>/abort), which
# answers {"interrupted": bool} and is a clean no-op for an idle session. Same
# server/credential resolution as every dispatch; the password never reaches a
# command line.
#
# Exit 0 when every named session ended up not running; 1 on a usage or
# transport error, or if a session is still active afterwards.
#
# --auto passes OpenCode's own --auto through to `opencode run`: it is
# documented to auto-approve any permission not explicitly `deny`d in the
# dispatched agent's own permission block, `deny` entries (e.g. builder.md's
# `rm -rf /*` / `sudo *` / `curl *`) staying blocked. Verified live on
# opencode v1 — a deny-listed `curl *` was refused with --auto on.
#
# ** Do not extend that v1 verification to v2 on the strength of anything
# written below — including this comment's own history. ** A 2026-09-27
# scratch-dir test initially seemed to show --auto executing a deny-listed
# `curl *` anyway on v2.0.18. A same-day re-test via `GET /api/agent/<name>`
# seemed to clear it, and a separate same-day check seemed to confirm a
# specific cause instead: mixing `temperature:` with the newer native
# `permissions:` array frontmatter format silently drops the whole ruleset
# to bare `*:* allow` (these templates use the nested `permission:` form,
# unaffected if that's real). Both of those conclusions were reached the
# same way — comparing `GET /api/agent/<name>` responses — and a still-later
# same-day finding, on a project actually scaffolded from these templates,
# showed that check can be misleading in two independent ways: (1) a
# long-lived `opencode serve` process can cache the resolved config it read
# at startup, so a `GET` after editing the file on disk can describe a
# version of the agent that no longer exists (restart the server, or use a
# command that reads from disk, before trusting a check — this toolkit has
# not itself verified whether one exists, e.g. an `opencode debug agents`
# subcommand was reported but is unconfirmed from here); (2) a scratch-dir
# repro built by hand-copying an agent file is not the same artifact as the
# real one — a copy made in the course of diagnosing the issue can silently
# differ from it (a duplicate line quietly deduplicated, whitespace
# normalized) and pass a check the original fails. That later finding
# pointed at a third possible cause, also unconfirmed: duplicate keys inside
# one nested permission map (e.g. two `"git reset*":` lines under the same
# `shell:` block) rejecting the whole mapping in opencode v2, distinct from
# the temperature+array theory above. Checked directly against these
# templates: none of builder/reviewer/tester.md.tmpl has a duplicate key
# within any single permission map, and a naive check that flattens the
# whole frontmatter body and looks for a repeated quoted string is NOT valid
# evidence either way — it flags a false positive on this toolkit's own
# `tester.md.tmpl` (`"*"`, two other patterns) purely because the sibling
# `edit:` and `write:` maps happen to key the same pattern, which is normal
# and not a duplicate. A real check has to scope by which mapping a key
# falls under.
#
# Net: none of the three explanations (temperature+array mixing, duplicate
# keys, a stale-server false-clear) is confirmed against these templates
# specifically, and neither is the original --auto question closed. **Before
# trusting any agent's deny rules on this opencode version — with --auto or
# without it — verify the live, resolved ruleset yourself**, against a
# server you just restarted (or a disk-reading command) and the exact file
# in question, not a copy:
#   opencode api GET /api/agent --server <url> --param directory=<repo-root> \
#     | python3 -c 'import json,sys; d=json.load(sys.stdin); \
#       print([a for a in d["data"] if a["id"]=="<agent-name>"])'
# and confirm the expected deny/ask entries are actually present in the
# returned `permissions` array.
#
# Separately, and true regardless of any of the above: upstream issue
# #42436 (github.com/anomalyco/opencode, open as of 2026-09-27) documents
# `deny` rules that DID load still being evadable via CWD-relative scripts
# and argv-code gadgets (`python3 -c`, `cargo run`, `node -e`, `env <cmd>`)
# that aren't path-scored by the permission scanner, and #35238 (also
# reported open) covers the v2 subagent tool not enforcing per-target
# subagent permissions — a `task`/`subagent` deny is not a boundary on
# *which* subagent gets launched. None of the agent templates here rely on
# denying those specific gadgets or subagent targets, but treat every
# permission block generated from these templates as a guardrail against
# accidents, not a hard sandbox boundary against a determined or
# compromised agent — that boundary is the environment (scratch dirs,
# disposable creds, no prod URLs), not this permission block.
#
# OpenCode's own --help calls --auto "dangerous"; it is off unless passed,
# and the lead should only pass it for a task the user explicitly confirmed
# at spec approval (see feature.md's step 1) — not as a standing default.
#
# --- How a run is bounded (idle watchdog, not a flat clock) --------------
#
# A flat wall-clock kill is wrong for these models: builder/reviewer runs on
# opencode-go/glm-5.3-flash and kimi-k2.7-code routinely do 20-60 min of
# genuinely active work, and a flat timeout SIGTERMs them mid-tool-call.
#
# So this script backgrounds `opencode run` and polls the OpenCode server for
# this session's *last message* (GET /api/session/<id>/message?limit=1). While
# the agent works, that message's parts and text grow, so its byte-fingerprint
# keeps changing; when a turn is genuinely wedged (an unanswered permission
# prompt, a black-holed provider call) the fingerprint is frozen. The run is
# aborted only when:
#   - the fingerprint does not change for OC_IDLE_TIMEOUT seconds AND the
#     message has no `completed` timestamp (a real wedge), or
#   - the absolute OC_TIMEOUT ceiling is reached while still running.
# A run that keeps making progress is left alone however long it takes.
#
# Signals that were tried and rejected against opencode 1.18.x, don't
# re-introduce without re-verifying on the installed version:
#   - `opencode run --format json` stdout / the --raw-out file: buffers to
#     end-of-turn (0 bytes, or one tiny early chunk, then nothing until the
#     whole turn flushes at once) — can't tell "stuck" from "working".
#   - GET /session/<id> state (time.updated / tokens / cost): only advances at
#     some step boundaries, sat frozen through 80s of active file-reading.
#   - GET /event and GET /session/<id>/event SSE: emit only
#     server.connected / server.heartbeat, never per-message/step/tool events.
# The /api/session/<id>/message?limit=1 body is the one thing observed to
# track sub-turn progress *and* carry the `completed` flag. Not re-verified
# against v2's SSE/event endpoints — carried over from the v1 finding as a
# reasonable default, not re-tested.
#
# v2 note: watchdog polling goes through `opencode api` (see oc_api() below),
# not raw curl — v2 always auth-gates the API (see the password section
# below) and plain curl with an Authorization/Basic/custom-header guess
# returned 401 in testing on this install, while `opencode api` with
# OPENCODE_PASSWORD set worked. The exact header scheme `opencode api` uses
# is not documented publicly as of this writing; matches a known open
# upstream report of broken/unclear v2 Basic Auth. Re-test raw curl if a
# future opencode release documents the header — `opencode api` adds one
# process-spawn of latency per poll (~0.15-0.2s observed), immaterial at the
# default 20s poll interval.
#
# If the session id can't be resolved (a fresh --session-less run, server slow
# to list it) or the message endpoint keeps erroring, the watchdog disables
# itself and the only bound is the OC_TIMEOUT ceiling — never worse than a
# flat timeout.
#
# Killing the client does NOT cancel the server-side turn (--server sessions
# outlive the CLI). So on any abort this script calls POST
# /api/session/<id>/interrupt (v1 called this endpoint /session/<id>/abort;
# v2 renamed it. Verified live against a real v2.0.18 server: returns
# {"interrupted": bool}, no-ops cleanly if the turn had already finished)
# before it exits 124. The watchdog resolves the session id even for a fresh
# run, so this abort now always has a target.
#
# --- Pipeline telemetry -----------------------------------------------------
#
# Every call appends one JSON line to .pipeline/logs/pipeline.jsonl (the dir is
# created on first use, and init.sh adds it to a target repo's .gitignore —
# it is machine state, like .pipeline/.oc-port). Fields: ts, agent, model,
# session, wall_s, status, kill_reason, and — best-effort from
# GET /session/<id> — token counts and cost. This is what makes the
# pipeline's *own* $/min per role answerable after the fact, instead of only
# when a timeout forces someone to look. Purely additive and best-effort: a
# failure to resolve cost, create the dir, or write the line never fails the
# run or changes its exit code.
#
# Env:
#   OC_SERVER        default http://localhost:4096, or the port
#                    scripts/team.sh last started (read from
#                    .pipeline/.oc-port) if that file exists and OC_SERVER
#                    isn't set — see scripts/team.sh's own header for why.
#   OC_PASSWORD      the OPENCODE_PASSWORD to authenticate with, or read from
#                    .pipeline/.oc-password (written by scripts/team.sh) if
#                    that file exists and OC_PASSWORD isn't set. Required —
#                    opencode v2 always auth-gates the API (v1 had none).
#   OC_TIMEOUT       absolute ceiling, seconds. Default 2400. A run still
#                    making progress is killed here; raise it for a job
#                    legitimately longer than 40 min.
#   OC_IDLE_TIMEOUT  seconds the session's last message may stay byte-for-byte
#                    unchanged, while not completed, before the run is treated
#                    as wedged and aborted. Default 600.
#   OC_POLL          fingerprint poll interval, seconds. Default 20.
#
# Exit codes:
#   0   ok
#   1   usage or runtime error
#   124 aborted — either idle (no progress for OC_IDLE_TIMEOUT; usually a
#       permission prompt in a non-TTY, unless --auto was passed, or a hung
#       provider call) or the OC_TIMEOUT ceiling. The stderr message says
#       which. The server-side session is aborted automatically.
# END USAGE

set -eu

CEIL_SECS="${OC_TIMEOUT:-2400}"
IDLE_SECS="${OC_IDLE_TIMEOUT:-600}"
POLL_SECS="${OC_POLL:-20}"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "${OC_SERVER:-}" ]; then
  SERVER="$OC_SERVER"
elif [ -f "$REPO_ROOT/.pipeline/.oc-port" ]; then
  SERVER="http://localhost:$(cat "$REPO_ROOT/.pipeline/.oc-port")"
else
  SERVER="http://localhost:4096"
fi

if [ -n "${OC_PASSWORD:-}" ]; then
  OPENCODE_PASSWORD="$OC_PASSWORD"
elif [ -f "$REPO_ROOT/.pipeline/.oc-password" ]; then
  OPENCODE_PASSWORD="$(cat "$REPO_ROOT/.pipeline/.oc-password")"
else
  # Preserve a password the caller already exported (e.g. hand-launched
  # `opencode serve` with a chosen OPENCODE_PASSWORD) instead of clobbering
  # it with an empty string.
  OPENCODE_PASSWORD="${OPENCODE_PASSWORD:-}"
fi
export OPENCODE_PASSWORD

AGENT=""
MODEL=""
PROMPT=""
PROMPT_FILE=""
TEXT_ONLY=0
RAW_OUT=""
SESSION=""
AUTO=0
STATUS=0
STATUS_IDS=""
INTERRUPT=0

die() { printf '%s\n' "oc.sh: $*" >&2; exit 1; }

usage() {
  awk '/^# BEGIN USAGE$/ {f=1; next} /^# END USAGE$/ {f=0} f' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# GNU timeout is `timeout` on Linux and via coreutils on macOS, `gtimeout` when
# coreutils is installed unprefixed-off. Resolve whichever exists. Defined here
# rather than next to the watchdog because oc_api() — the one authenticated API
# call, shared by the watchdog and the --status operation below — needs it.
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="gtimeout"
else
  die "neither 'timeout' nor 'gtimeout' found — install coreutils (brew install coreutils)"
fi

# The single authenticated API entry point: `opencode api` authenticates via
# OPENCODE_PASSWORD (already exported above) and plain curl could not reproduce
# that auth in testing — v2 always auth-gates the API (see the password section
# of this header). Resolved in one place so the watchdog and `--status` can
# never drift from a dispatch, and so the password never reaches a command
# line. Bounded with $TIMEOUT_BIN since `opencode api` has no per-request
# timeout of its own.
oc_api() { "$TIMEOUT_BIN" 10 opencode api "$@" --server "$SERVER" 2>/dev/null; }

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)       [ $# -ge 2 ] || die "--agent needs a value";       AGENT="$2";       shift 2 ;;
    --model)       [ $# -ge 2 ] || die "--model needs a value";       MODEL="$2";       shift 2 ;;
    --prompt)      [ $# -ge 2 ] || die "--prompt needs a value";      PROMPT="$2";      shift 2 ;;
    --prompt-file) [ $# -ge 2 ] || die "--prompt-file needs a value"; PROMPT_FILE="$2"; shift 2 ;;
    --text)        TEXT_ONLY=1; shift ;;
    --raw-out)     [ $# -ge 2 ] || die "--raw-out needs a value";     RAW_OUT="$2";     shift 2 ;;
    --session)     [ $# -ge 2 ] || die "--session needs a value";     SESSION="$2";     shift 2 ;;
    --auto)        AUTO=1; shift ;;
    # Everything after --status is a session id, so --status is always last.
    --status)      STATUS=1; shift; STATUS_IDS="$*"; break ;;
    # Same shape: everything after --interrupt is a session id.
    --interrupt)   INTERRUPT=1; shift; STATUS_IDS="$*"; break ;;
    -h|--help)     usage ;;
    *)             die "unknown argument: $1  (try --help)" ;;
  esac
done

# --- read-only status operation ------------------------------------------
# Every active/not-active verdict below is keyed to a session id the caller
# named, so this never reports on a session nobody asked about. With no ids
# it prints v2's raw active-session map, which is what makes the "nothing is
# running" case observable as {"data":{}}.
if [ "$STATUS" -eq 1 ]; then
  printf '%s\n' "oc.sh: status: server=$SERVER ids=${STATUS_IDS:-all}" >&2
  ACTIVE="$(oc_api GET /api/session/active || true)"
  [ -n "$ACTIVE" ] || die "could not read active sessions from $SERVER — start a server with:
     scripts/team.sh   (or OPENCODE_PASSWORD=\"\$(cat .pipeline/.oc-password)\" opencode serve --port 4096)"
  ACTIVE="$ACTIVE" python3 -c '
import json, os, sys
raw = os.environ["ACTIVE"]
try:
    d = json.loads(raw)
except ValueError:
    sys.exit("oc.sh: unreadable /api/session/active response — refusing to call sessions inactive")
if isinstance(d, dict) and "data" in d:
    d = d["data"]
if not isinstance(d, dict):
    sys.exit("oc.sh: unexpected /api/session/active shape (expected an object)")
ids = sys.argv[1:]
if not ids:
    sys.stdout.write(raw.strip() + "\n")
else:
    for i in ids:
        print("%s: %s" % (i, "active" if i in d else "not active"))
' ${STATUS_IDS:-}
  exit 0
fi

# --- interrupt operation ----------------------------------------------------
# Only ever touches the sessions the caller named; there is no "interrupt all".
if [ "$INTERRUPT" -eq 1 ]; then
  [ -n "$STATUS_IDS" ] || die "--interrupt needs at least one session id"
  printf '%s\n' "oc.sh: interrupt: server=$SERVER ids=$STATUS_IDS" >&2
  FAILED=0
  for SID in $STATUS_IDS; do
    case "$SID" in ses_*) : ;; *) die "not a session id: $SID" ;; esac
    oc_api POST "/api/session/$SID/interrupt" >/dev/null || true
    ACTIVE="$(oc_api GET /api/session/active || true)"
    [ -n "$ACTIVE" ] || die "could not read active sessions from $SERVER after interrupting $SID"
    if ACTIVE="$ACTIVE" python3 -c '
import json, os, sys
d = json.loads(os.environ["ACTIVE"])
d = d.get("data", d) if isinstance(d, dict) else d
sys.exit(0 if isinstance(d, dict) and sys.argv[1] in d else 1)
' "$SID"; then
      printf '%s: still active\n' "$SID"; FAILED=1
    else
      printf '%s: not running\n' "$SID"
    fi
  done
  exit "$FAILED"
fi

[ -n "$AGENT" ] || die "--agent is required"
[ -n "$MODEL" ] || die "--model is required"

# Resolve a relative --raw-out against the caller's CWD now, before this
# script cd's into $REPO_ROOT below (v2's `opencode run` dropped --dir; the
# project directory is now whatever the process's CWD is when it runs).
if [ -n "$RAW_OUT" ]; then
  case "$RAW_OUT" in
    /*) : ;;
    *) RAW_OUT="$(pwd)/$RAW_OUT" ;;
  esac
fi

# Prompt from --prompt, --prompt-file, or stdin, in that order.
if [ -z "$PROMPT" ]; then
  if [ -n "$PROMPT_FILE" ]; then
    [ -f "$PROMPT_FILE" ] || die "prompt file not found: $PROMPT_FILE"
    PROMPT="$(cat "$PROMPT_FILE")"
  elif [ ! -t 0 ]; then
    PROMPT="$(cat)"
  fi
fi
[ -n "$PROMPT" ] || die "no prompt given (--prompt, --prompt-file, or stdin)"

# Fail fast with a clear message rather than letting --server silently fall
# back to a cold local server, which is the slow path this wrapper exists to
# avoid. This also validates OPENCODE_PASSWORD — v2 answers 200 with the web
# UI's HTML on a bare `curl "$SERVER"` regardless of auth, so a plain
# reachability probe alone would not have caught a missing/wrong password.
if ! "$TIMEOUT_BIN" 10 opencode api GET /api/session --server "$SERVER" --param limit=1 >/dev/null 2>&1; then
  die "no opencode server (or bad OPENCODE_PASSWORD) at $SERVER — start one with:
     OPENCODE_PASSWORD=\"\$(cat .pipeline/.oc-password)\" opencode serve --port 4096
     (or run scripts/team.sh, which starts it in pane 1 with the password wired up)"
fi

printf '%s\n' "oc.sh: agent=$AGENT model=$MODEL ceiling=${CEIL_SECS}s idle=${IDLE_SECS}s server=$SERVER session=${SESSION:-new} auto=$AUTO" >&2

# v2's `opencode run` has no --dir flag; it takes the project directory from
# its own CWD. RAW_OUT was already resolved to an absolute path above, so
# this is safe to do now.
cd "$REPO_ROOT"

RAW_TMP="$(mktemp "${TMPDIR:-/tmp}/oc-raw.XXXXXX")"
trap 'rm -f "$RAW_TMP"' EXIT

SESSION_ARGS=()
[ -n "$SESSION" ] && SESSION_ARGS=(--session "$SESSION")

AUTO_ARGS=()
[ "$AUTO" -eq 1 ] && AUTO_ARGS=(--auto)

# --- watchdog helpers ---------------------------------------------------

# md5 of stdin, portable across macOS (`md5`) and Linux (`md5sum`).
_md5() { if command -v md5 >/dev/null 2>&1; then md5 -q; else md5sum | cut -d' ' -f1; fi; }

# Every current session id, newest first (empty on any error). v2 paginates
# (default page size well under this project's total session count), but
# newest-first ordering means a just-created session is always on this page.
list_session_ids() {
  oc_api GET /api/session --param limit=100 --param order=desc \
    | grep -o '"id":"ses_[^"]*"' | cut -d'"' -f4
}

# Echo the first session id present now but not in $1 (newline-separated list).
resolve_new_session() {
  local pre="$1" id
  for id in $(list_session_ids); do
    printf '%s\n' "$pre" | grep -qxF "$id" || { printf '%s\n' "$id"; return 0; }
  done
  return 1
}

# The newest message in a session, as compact JSON on stdout (or nothing).
# `--param limit=1`/`order=desc` are passed as a hint, but verified live to be
# ignored by this endpoint on the installed v2.0.18 (it always returns full
# history) — so this never trusts server-side limiting/ordering and instead
# picks by max(time.created) itself, client-side, over whatever came back.
# v1's equivalent code took the last array element, which was correct when v1
# returned messages oldest-first; v2 returns them newest-first, so blindly
# porting that indexing (`d[-1]`) would have silently picked the *oldest*
# message instead — caught by live testing before this shipped.
latest_message_json() {
  oc_api GET "/api/session/$1/message" --param order=desc --param limit=1 | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if isinstance(d, dict) and "data" in d:
    d = d["data"]
if isinstance(d, list) and d:
    def created(m):
        info = m.get("info", m) if isinstance(m, dict) else {}
        return (info.get("time", {}) or {}).get("created", 0)
    print(json.dumps(max(d, key=created), sort_keys=True))
' 2>/dev/null
}

# Fingerprint of a session's newest message: "<size>:<md5>", or "" if
# unreadable. Changes whenever that message's parts/text grow; stable once a
# turn stops producing new content — that stability is what "wedged" means.
message_fp() {
  local body
  body="$(latest_message_json "$1")" || return 0
  [ -n "$body" ] && printf '%s:%s' "$(printf '%s' "$body" | wc -c | tr -d ' ')" "$(printf '%s' "$body" | _md5)"
  return 0
}

# Exit 0 if the newest message carries a `completed` timestamp.
turn_completed() {
  local body
  body="$(latest_message_json "$1")" || return 1
  [ -n "$body" ] || return 1
  printf '%s' "$body" | python3 -c '
import json, sys
try:
    m = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
info = m.get("info", m) if isinstance(m, dict) else {}
raise SystemExit(0 if (info.get("time", {}) or {}).get("completed") else 1)
' 2>/dev/null
}

# --- launch + keep-alive watchdog -------------------------------------

PRE_SESSIONS=""
[ -z "$SESSION" ] && PRE_SESSIONS="$(list_session_ids)"

set +e
# Outer `timeout` is only an ultimate backstop for a wedged watchdog loop;
# the watchdog itself enforces the real OC_TIMEOUT ceiling below.
printf '%s' "$PROMPT" | "$TIMEOUT_BIN" "$((CEIL_SECS + 300))" \
  opencode run \
    --server "$SERVER" \
    --agent "$AGENT" \
    --model "$MODEL" \
    ${SESSION_ARGS[@]+"${SESSION_ARGS[@]}"} \
    ${AUTO_ARGS[@]+"${AUTO_ARGS[@]}"} \
    --format json > "$RAW_TMP" 2>>"$RAW_TMP" &
OC_PID=$!

WATCH_SID="$SESSION"
KILL_REASON=""
START_TS="$(date +%s)"
LAST_PROGRESS="$START_TS"
RESOLVE_DEADLINE="$((START_TS + 60))"
FP_PREV=""

while kill -0 "$OC_PID" 2>/dev/null; do
  sleep "$POLL_SECS"
  NOW="$(date +%s)"

  if [ -z "$WATCH_SID" ]; then
    WATCH_SID="$(resolve_new_session "$PRE_SESSIONS")" || WATCH_SID=""
    if [ -n "$WATCH_SID" ]; then
      LAST_PROGRESS="$NOW"
    elif [ "$NOW" -ge "$RESOLVE_DEADLINE" ]; then
      break   # can't identify this run's session — leave it to the ceiling
    fi
    continue
  fi

  FP="$(message_fp "$WATCH_SID")"
  if [ -n "$FP" ] && [ "$FP" != "$FP_PREV" ]; then
    FP_PREV="$FP"
    LAST_PROGRESS="$NOW"
  fi

  if [ "$((NOW - LAST_PROGRESS))" -ge "$IDLE_SECS" ]; then
    turn_completed "$WATCH_SID" && break   # finished between polls; let it flush
    KILL_REASON="idle"
    kill -TERM "$OC_PID" 2>/dev/null
    break
  fi

  if [ "$((NOW - START_TS))" -ge "$CEIL_SECS" ]; then
    KILL_REASON="ceiling"
    kill -TERM "$OC_PID" 2>/dev/null
    break
  fi
done

wait "$OC_PID"
STATUS=$?
set -e

[ -n "$RAW_OUT" ] && cp "$RAW_TMP" "$RAW_OUT"

# Report the session id actually used, whatever the outcome, so the caller can
# persist it in this role's field and continue that session on the role's next
# call for this task. The
# watchdog resolves it even for a fresh run; fall back to the raw stream.
USED_SESSION="$WATCH_SID"
[ -n "$USED_SESSION" ] || USED_SESSION="$(grep -o '"sessionID":"[^"]*"' "$RAW_TMP" 2>/dev/null | head -1 | cut -d'"' -f4)"
[ -n "$USED_SESSION" ] && printf '%s\n' "oc.sh: session=$USED_SESSION" >&2

# --- pipeline telemetry (best-effort; never fails the run) ----------------
{
  TELEMETRY_DIR="$REPO_ROOT/.pipeline/logs"
  if mkdir -p "$TELEMETRY_DIR" 2>/dev/null; then
    "$TIMEOUT_BIN" 10 opencode api GET "/api/session/${USED_SESSION:-none}" --server "$SERVER" 2>/dev/null | python3 -c '
import json, sys, datetime
extra = {}
try:
    d = json.loads(sys.stdin.read())
    if isinstance(d, dict) and "data" in d:
        d = d["data"]
    d = d[0] if isinstance(d, list) and d else d
    if isinstance(d, dict):
        for k in ("cost", "tokens"):
            if k in d:
                extra[k] = d[k]
except Exception:
    pass
rec = {
    "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
    "agent": sys.argv[1],
    "model": sys.argv[2],
    "session": sys.argv[3] or None,
    "wall_s": int(sys.argv[4]),
    "status": int(sys.argv[5]),
    "kill_reason": sys.argv[6] or None,
}
rec.update(extra)
with open(sys.argv[7], "a") as fh:
    fh.write(json.dumps(rec) + "\n")
' "$AGENT" "$MODEL" "${USED_SESSION:-}" "$(( $(date +%s) - START_TS ))" "$STATUS" "$KILL_REASON" \
      "$TELEMETRY_DIR/pipeline.jsonl" 2>/dev/null || true
  fi
} || true

emit() {
  if [ "$TEXT_ONLY" -eq 1 ]; then
    # Concatenate the text parts in order; that is the agent's actual answer.
    python3 -c '
import json, sys
for line in open(sys.argv[1]):
    line = line.strip()
    if not line: continue
    try: e = json.loads(line)
    except ValueError: continue
    if e.get("type") == "text":
        t = e.get("part", {}).get("text")
        if t: sys.stdout.write(t)
sys.stdout.write("\n")
' "$RAW_TMP"
  else
    cat "$RAW_TMP"
  fi
}

# An abort — from the watchdog (KILL_REASON set) or the outer backstop
# (STATUS 124) — is reported the same way and always exits 124.
if [ -n "$KILL_REASON" ] || [ "$STATUS" -eq 124 ]; then
  [ -n "$KILL_REASON" ] || KILL_REASON="ceiling"
  ABORT_SESSION="${WATCH_SID:-$USED_SESSION}"
  if [ -n "$ABORT_SESSION" ]; then
    "$TIMEOUT_BIN" 10 opencode api POST "/api/session/$ABORT_SESSION/interrupt" --server "$SERVER" >/dev/null 2>&1 || true
    ABORT_NOTE="Aborted server-side session $ABORT_SESSION so it won't orphan the next call — retrying is safe."
  else
    ABORT_NOTE="No session id was known to abort. If this session gets reused, check it isn't still running server-side before sending the next message."
  fi

  if [ "$KILL_REASON" = "idle" ]; then
    WHY="the session's last message did not change for ${IDLE_SECS}s while a turn was still open"
    HINT="That is what a wedged run looks like — almost always a permission prompt
  with no TTY to answer it:
    - Widen .opencode/agents/$AGENT.md's shell permissions to cover the command
      that stopped it, and set 'question: deny'.
    - --auto is a reasonable workaround here (see this script's own --auto
      comment above): re-verified live, it correctly auto-approves only
      'ask' entries and still honors 'deny' — it is not, as an earlier
      version of this comment claimed, a way to bypass deny rules. Before
      relying on it for an unattended run, confirm via 'GET /api/agent/$AGENT'
      (see the --auto comment above) that the expected deny rules actually
      loaded — a silent ruleset-load failure is the real risk on this
      opencode version, not --auto itself.
  If neither applies the provider call may have hung — check --raw-out for the
  last event before the stall, then resume the same --session id."
  else
    WHY="the run hit the absolute ${CEIL_SECS}s ceiling while still active"
    HINT="If the job is legitimately this long, raise OC_TIMEOUT (seconds) for
  this dispatch. A wedged run is caught by OC_IDLE_TIMEOUT (${IDLE_SECS}s)
  well before this; hitting the ceiling means it was genuinely still working."
  fi

  cat >&2 <<MSG

oc.sh: ABORTED — $WHY (agent=$AGENT model=$MODEL)

  $ABORT_NOTE

  $HINT

  Reproduce interactively to watch it run:
    opencode run --server $SERVER --agent $AGENT --model $MODEL "<prompt>"

MSG
  exit 124
fi

if [ "$STATUS" -ne 0 ]; then
  emit
  printf '%s\n' "oc.sh: opencode exited $STATUS (agent=$AGENT model=$MODEL)" >&2
  exit "$STATUS"
fi

emit
