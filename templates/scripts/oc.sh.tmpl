#!/usr/bin/env bash
#
# Wrapper for every OpenCode invocation in the agent pipeline.
#
# Why this exists rather than calling `opencode run` directly:
#
#   1. --attach reuses an already-running `opencode serve`, skipping MCP cold
#      boot on every call. Without it each invocation pays startup again.
#   2. `opencode run` hangs forever if the agent hits a permission prompt in a
#      non-TTY. That is the known failure mode this wrapper exists to guard
#      against, so every call is bounded by a hard timeout and a non-zero exit.
#   3. Model is an argument, so the lead can switch vendors without editing a
#      single agent prompt.
#
# Usage:
#   scripts/oc.sh --agent reviewer --model hcnsec/DeepSeek-V4-Pro \
#                 --prompt-file .agents/T-001.review-request.md
#   scripts/oc.sh --agent tester --model hcnsec/auto --prompt "run the suite"
#   echo "..." | scripts/oc.sh --agent reviewer --model hcnsec/glm-5.3
#
# --session <id> continues an existing OpenCode session instead of starting a
# new one — pass the session id captured from an earlier call's "session=..."
# line (also visible in --raw-out as each event's sessionID). The pipeline's
# session scope is one feature/task, not one call: implement, review, and test
# for the same T-<id> continue the same session; a new one starts only for the
# next task. Every call (with or without --session) prints the session id it
# used to stderr on completion so the caller can record it.
#
# --text extracts just the agent's final prose from the JSON event stream. The
# raw stream is still what crosses the wire (and is kept with --raw-out), but it
# inlines the full contents of every file the agent reads, so it is unreadable
# for a human and expensive to paste back into a state file.
#
# --auto passes OpenCode's own --auto through to `opencode run`: it
# auto-approves any permission not explicitly `deny`d in the dispatched
# agent's own permission block — a bash "ask" catch-all included — instead
# of hanging on a prompt nothing can answer non-interactively. `deny`
# entries (e.g. builder.md's `rm -rf /*` / `sudo *` / `curl *`) still
# block — OpenCode stays in the loop, this isn't "ignore all permissions."
# Verified live: a throwaway agent with a deny-listed `curl *` still had
# that call refused with `--auto` on. OpenCode's own --help calls it
# "dangerous"; it is off unless passed, and the lead should only pass it
# for a task the user explicitly confirmed at spec approval (see
# feature.md's step 1) — not as a standing default.
#
# Timeout is a flat wall-clock kill (OC_TIMEOUT, default 600s), not an
# idle-based one. An idle/no-output watchdog was tried and reverted: it
# relies on the raw JSON output file growing as the agent works, but
# `opencode run --format json` (verified against v1.18.18, --attach, both
# --format json and --format default, with and without `stdbuf -oL`)
# writes nothing to its own stdout until the *entire turn completes* — the
# file sits at 0 bytes through 12+ seconds of genuinely active, multi-step
# work. Polling its size can't tell "stuck" from "working" here; it would
# kill every run past the idle threshold, successful or not. If opencode
# ever starts streaming incrementally, or a server-side polling approach
# (session message state via the HTTP API, not the client's stdout) is
# worth the added complexity, revisit this — but don't re-introduce
# file-size polling without re-verifying it against the actual installed
# opencode version first.
#
# Killing the client does NOT cancel the server-side turn (--attach
# sessions outlive the CLI process) — a killed run can leave an orphaned
# message with no `completed` timestamp, and reusing that session for a
# later call can then hang forever behind it. So on a timeout this script
# calls the server's abort endpoint on whatever session id it can
# determine (the `--session` it was given, if any — the client rarely has
# a session id of its own to fall back on, per the buffering note above)
# before it exits 124 — verified live against a real OpenCode 1.x server
# (POST /session/<id>/abort returns 200, and no-ops cleanly if the turn
# had already finished).
#
# Env:
#   OC_SERVER   default http://localhost:4096, or the port scripts/team.sh
#               last started (read from .agents/.oc-port) if that file
#               exists and OC_SERVER isn't set — see scripts/team.sh's own
#               header for why (running two projects at once needs two
#               ports, and this is what lets oc.sh find the right one
#               without you exporting OC_SERVER by hand every call).
#   OC_TIMEOUT  default 600 (seconds)
#
# Exit codes:
#   0   ok
#   1   usage or runtime error
#   124 timed out (almost always a permission prompt in a non-TTY, unless
#       --auto was passed). The server-side session is aborted
#       automatically when a session id is known; see the note above for
#       when it isn't.

set -eu

TIMEOUT_SECS="${OC_TIMEOUT:-600}"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "${OC_SERVER:-}" ]; then
  SERVER="$OC_SERVER"
elif [ -f "$REPO_ROOT/.agents/.oc-port" ]; then
  SERVER="http://localhost:$(cat "$REPO_ROOT/.agents/.oc-port")"
else
  SERVER="http://localhost:4096"
fi

AGENT=""
MODEL=""
PROMPT=""
PROMPT_FILE=""
TEXT_ONLY=0
RAW_OUT=""
SESSION=""
AUTO=0

die() { printf '%s\n' "oc.sh: $*" >&2; exit 1; }

usage() {
  sed -n '3,87p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --agent)       [ $# -ge 2 ] || die "--agent needs a value";       AGENT="$2";       shift 2 ;;
    --model)       [ $# -ge 2 ] || die "--model needs a value";       MODEL="$2";       shift 2 ;;
    --prompt)      [ $# -ge 2 ] || die "--prompt needs a value";      PROMPT="$2";      shift 2 ;;
    --prompt-file) [ $# -ge 2 ] || die "--prompt-file needs a value"; PROMPT_FILE="$2"; shift 2 ;;
    --text)        TEXT_ONLY=1; shift ;;
    --raw-out)     [ $# -ge 2 ] || die "--raw-out needs a value";     RAW_OUT="$2";     shift 2 ;;
    --session)     [ $# -ge 2 ] || die "--session needs a value";     SESSION="$2";     shift 2 ;;
    --auto)        AUTO=1; shift ;;
    -h|--help)     usage ;;
    *)             die "unknown argument: $1  (try --help)" ;;
  esac
done

[ -n "$AGENT" ] || die "--agent is required"
[ -n "$MODEL" ] || die "--model is required"

# Prompt from --prompt, --prompt-file, or stdin, in that order.
if [ -z "$PROMPT" ]; then
  if [ -n "$PROMPT_FILE" ]; then
    [ -f "$PROMPT_FILE" ] || die "prompt file not found: $PROMPT_FILE"
    PROMPT="$(cat "$PROMPT_FILE")"
  elif [ ! -t 0 ]; then
    PROMPT="$(cat)"
  fi
fi
[ -n "$PROMPT" ] || die "no prompt given (--prompt, --prompt-file, or stdin)"

# GNU timeout is `timeout` on Linux and via coreutils on macOS, `gtimeout` when
# coreutils is installed unprefixed-off. Resolve whichever exists.
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="gtimeout"
else
  die "neither 'timeout' nor 'gtimeout' found — install coreutils (brew install coreutils)"
fi

# Fail fast with a clear message rather than letting --attach silently fall back
# to a cold local server, which is the slow path this wrapper exists to avoid.
if ! curl -sS -o /dev/null -m 5 "$SERVER" 2>/dev/null; then
  die "no opencode server at $SERVER — start one with:  opencode serve --port 4096
     (or run scripts/team.sh, which starts it in pane 1)"
fi

printf '%s\n' "oc.sh: agent=$AGENT model=$MODEL timeout=${TIMEOUT_SECS}s server=$SERVER session=${SESSION:-new} auto=$AUTO" >&2

RAW_TMP="$(mktemp "${TMPDIR:-/tmp}/oc-raw.XXXXXX")"
trap 'rm -f "$RAW_TMP"' EXIT

SESSION_ARGS=()
[ -n "$SESSION" ] && SESSION_ARGS=(--session "$SESSION")

AUTO_ARGS=()
[ "$AUTO" -eq 1 ] && AUTO_ARGS=(--auto)

set +e
printf '%s' "$PROMPT" | "$TIMEOUT_BIN" "$TIMEOUT_SECS" \
  opencode run \
    --attach "$SERVER" \
    --dir "$REPO_ROOT" \
    --agent "$AGENT" \
    --model "$MODEL" \
    ${SESSION_ARGS[@]+"${SESSION_ARGS[@]}"} \
    ${AUTO_ARGS[@]+"${AUTO_ARGS[@]}"} \
    --format json > "$RAW_TMP"
STATUS=$?
set -e

[ -n "$RAW_OUT" ] && cp "$RAW_TMP" "$RAW_OUT"

# Report the session id actually used, whatever the outcome, so the caller can
# persist it and continue the same session on the next call for this task.
# (On a killed run this is usually empty — see the buffering note above.)
USED_SESSION="$(grep -o '"sessionID":"[^"]*"' "$RAW_TMP" 2>/dev/null | head -1 | cut -d'"' -f4)"
[ -n "$USED_SESSION" ] && printf '%s\n' "oc.sh: session=$USED_SESSION" >&2

emit() {
  if [ "$TEXT_ONLY" -eq 1 ]; then
    # Concatenate the text parts in order; that is the agent's actual answer.
    python3 -c '
import json, sys
for line in open(sys.argv[1]):
    line = line.strip()
    if not line: continue
    try: e = json.loads(line)
    except ValueError: continue
    if e.get("type") == "text":
        t = e.get("part", {}).get("text")
        if t: sys.stdout.write(t)
sys.stdout.write("\n")
' "$RAW_TMP"
  else
    cat "$RAW_TMP"
  fi
}

if [ "$STATUS" -eq 124 ]; then
  ABORT_SESSION="${SESSION:-$USED_SESSION}"
  if [ -n "$ABORT_SESSION" ]; then
    curl -sS -X POST -m 10 "$SERVER/session/$ABORT_SESSION/abort" -o /dev/null 2>/dev/null || true
    ABORT_NOTE="Aborted server-side session $ABORT_SESSION so it won't orphan the next call — retrying is safe."
  else
    ABORT_NOTE="No session id was known to abort (killed before any event reached this client — see the header note on output buffering). If this session gets reused, check it isn't still running server-side before sending the next message."
  fi

  cat >&2 <<MSG

oc.sh: TIMED OUT after ${TIMEOUT_SECS}s (agent=$AGENT model=$MODEL)

  $ABORT_NOTE

  The usual cause is a permission prompt with no TTY to answer it: opencode run
  waits forever instead of failing. Two ways to fix it:
    - Widen .opencode/agent/$AGENT.md's bash permissions to cover the command
      that stopped it, and set 'question: deny'.
    - Pass --auto to this script (only for a task the user has confirmed) —
      it auto-approves anything not explicitly 'deny'd instead of hanging
      on 'ask', without disabling the agent's deny list.

  If neither applies, it may just be a genuinely long run — raise OC_TIMEOUT.

  Reproduce interactively to see which prompt it stopped on:
    opencode run --attach $SERVER --agent $AGENT --model $MODEL "<prompt>"

MSG
  exit 124
fi

if [ "$STATUS" -ne 0 ]; then
  emit
  printf '%s\n' "oc.sh: opencode exited $STATUS (agent=$AGENT model=$MODEL)" >&2
  exit "$STATUS"
fi

emit
