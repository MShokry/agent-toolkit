#!/usr/bin/env bash
#
# Detached role dispatch for the lead — start one, then wait on it in bounded
# slices. Works the same for a Claude, Codex or OpenCode lead.
#
# Why this exists: the lead's own shell tool kills any command long before a
# role's turn can finish (Claude Code: 600s, even backgrounded; Codex: its exec
# timeout), and oc.sh's own ceiling is 2400s. A killed wrapper prints no
# completion line while the turn keeps running server-side, so it looks dead
# and is not (T-021, T-023). The fix was always "nohup … & disown, then watch
# the .err file" — but a Claude lead watched with its Monitor tool and a Codex
# lead has no Monitor at all. `wait` is that watch as a plain command: call it
# again until it reports a terminal state.
#
# BEGIN USAGE
#   scripts/bg-dispatch.sh start <T-id> <label> -- scripts/<wrapper> <args…>
#   scripts/bg-dispatch.sh wait  <T-id> <label> [max-seconds] [--session ses_…]
#
# The command must be one of this repo's dispatch wrappers: scripts/oc.sh
# (OpenCode roles) or scripts/claude-review.sh (the Claude reviewer). Each
# prints one completion line to stderr as its last act — `oc.sh: session=…`
# or `claude-review.sh: done …` — which is what `wait` looks for.
#
# <label> names the dispatch's files: .pipeline/<T-id>.<label>.{out,err,pid}
# (e.g. `builder`, `builder-fix-1`, `review-2`). `start` refuses while a live
# dispatch already owns that label — one writer per label, never two.
#
# `wait` blocks for at most max-seconds (default 540, under Claude Code's 600s
# tool limit; pass a smaller value when your own tool timeout is shorter) and
# prints exactly one line, with the exit code saying which:
#   0  finished: <the wrapper's completion line>
#   2  wrapper-exited: no completion line. With --session (OpenCode roles
#      only), adds that session's state from `oc.sh --status`: `active` means
#      the turn is still running server-side — keep waiting, do NOT
#      re-dispatch.
#   3  still-running pid=<n> — call `wait` again.
#   1  usage error.
# END USAGE

set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

die() { printf 'bg-dispatch.sh: %s\n' "$*" >&2; exit 1; }
usage() { awk '/^# BEGIN USAGE$/ {f=1; next} /^# END USAGE$/ {f=0} f' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

DONE_RE='^(oc\.sh: session=|claude-review\.sh: done)'

[ $# -ge 3 ] || usage
OP="$1" TASK="$2" LABEL="$3"
shift 3
[[ "$TASK" =~ ^T-[0-9]+$ ]] || die "task id must look like T-035: $TASK"
[[ "$LABEL" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "label must be lowercase letters, digits and dashes: $LABEL"

BASE=".pipeline/$TASK.$LABEL"
OUT="$BASE.out" ERR="$BASE.err" PIDF="$BASE.pid"

alive() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

case "$OP" in
  start)
    [ "${1:-}" = "--" ] || die "start needs -- before the wrapper command"
    shift
    case "${1:-}" in
      scripts/oc.sh|scripts/claude-review.sh) : ;;
      *) die "start runs scripts/oc.sh or scripts/claude-review.sh, not: ${1:-nothing}" ;;
    esac
    if alive; then
      die "a dispatch for $TASK $LABEL is still running (pid $(cat "$PIDF")); wait on it or interrupt it first"
    fi
    nohup "$@" > "$OUT" 2> "$ERR" < /dev/null &
    echo $! > "$PIDF"
    disown 2>/dev/null || true
    printf 'bg-dispatch.sh: started %s %s pid=%s err=%s out=%s\n' "$TASK" "$LABEL" "$(cat "$PIDF")" "$ERR" "$OUT"
    ;;
  wait)
    MAX=540 SID=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --session) [ $# -ge 2 ] || die "--session needs a value"; SID="$2"; shift 2 ;;
        *) [[ "$1" =~ ^[0-9]+$ ]] || die "max-seconds must be a number: $1"; MAX="$1"; shift ;;
      esac
    done
    [ -f "$ERR" ] || die "no dispatch recorded for $TASK $LABEL ($ERR missing)"
    END=$(( $(date +%s) + MAX ))
    while :; do
      if grep -qE "$DONE_RE" "$ERR"; then
        printf 'finished: %s\n' "$(grep -E "$DONE_RE" "$ERR" | tail -1)"
        exit 0
      fi
      if ! alive; then
        LAST="$(tail -1 "$ERR" 2>/dev/null || true)"
        if [ -n "$SID" ]; then
          printf 'wrapper-exited: %s; %s\n' "${LAST:-no stderr}" "$(scripts/oc.sh --status "$SID" 2>/dev/null | tail -1)"
        else
          printf 'wrapper-exited: %s\n' "${LAST:-no stderr}"
        fi
        exit 2
      fi
      NOW="$(date +%s)"
      [ "$NOW" -lt "$END" ] || { printf 'still-running pid=%s\n' "$(cat "$PIDF")"; exit 3; }
      sleep $(( END - NOW < 5 ? END - NOW : 5 ))
    done
    ;;
  *) usage ;;
esac
