#!/usr/bin/env python3
"""View toolkit task records from any terminal, without Herdr or model calls."""

from pathlib import Path
import runpy
import sys


if __name__ == "__main__":
    # Same standalone artifact that init installs as scripts/dashboard.
    sys.dont_write_bytecode = True
    runpy.run_path(str(Path(__file__).resolve().parents[1] / "integrations/herdr/dashboard.py"), run_name="__main__")
